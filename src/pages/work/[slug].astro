---
import Base from "../../layouts/Base.astro";
import Doodle from "../../components/Doodle.astro";
import ProjectFrame from "../../components/ProjectFrame.astro";
import { PROJECTS, SITE } from "../../data/site";

export function getStaticPaths() {
  return PROJECTS.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: PROJECTS[(i + 1) % PROJECTS.length] } }));
}

const { p, next } = Astro.props;
const path = `/work/${p.slug}`;
const code = p.links.find((l) => l.href.includes("github.com"));
const schema = [
  {
    "@type": p.slug === "engram" ? "ScholarlyArticle" : "SoftwareSourceCode",
    name: p.name,
    headline: `${p.name} — ${p.tagline}`,
    description: p.summary,
    author: { "@id": `${SITE.url}/#person` },
    ...(code ? { codeRepository: code.href } : {}),
    url: `${SITE.url}${path}`,
    keywords: p.stack.join(", "),
    dateModified: "2026-10-15",
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Rishabh Sharma", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Work", item: `${SITE.url}/#work` },
      { "@type": "ListItem", position: 3, name: p.name, item: `${SITE.url}${path}` },
    ],
  },
];
const doodle = { engram: "neural", archimedes: "book", omniharness: "robot", "area-o1": "sparkle", rallion: "headphones" }[p.slug] ?? "plant";
---

<Base nav="work" title={`${p.name}: ${p.tagline.replace(/[.—]+$/, "")} | Rishabh Sharma`} description={p.summary} path={path} schema={schema} ogType="article">
  <article class="cs">
    <a class="cs__back" href="/work">← all work</a>
    <Doodle name={doodle} class="float f-cream" style="right:-6%;top:90px;width:110px" data-float=".4" />
    <Doodle name="chai" class="float f-cream" style="left:-8%;top:40%;width:80px" data-float="-.4" />
  </article>
  <ProjectFrame slug={p.slug} link={false} level={1} />
  <article class="cs cs--body">
    <div class="cs__sheet">
      <ul class="cs__facts">{p.facts.map((f) => <li set:html={f.replace(/`([^`]+)`/g, "<code>$1</code>")} />)}</ul>
      {p.body.map((b) => (
        <section data-reveal>
          <h2>{b.heading}</h2>
          <p set:html={b.text.replace(/`([^`]+)`/g, "<code>$1</code>")} />
        </section>
      ))}
      <div class="cs__chips">{p.stack.map((s) => <span>{s}</span>)}</div>
      <div class="cs__links">{p.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}</div>
    </div>
    <a class="cs__next" href={`/work/${next.slug}`}><small>next entry →</small>{next.name}</a>
  </article>
</Base>
