---
// The end of the board: an (original) mecha doodle for the anime kid in me, and a ticker of
// songs on repeat and places I've been.
import { SITE } from "../data/site";
const ticker = [
  "Sweet Child O' Mine", "Puerto Rico, baby!", "Yellow", "Indore", "Philadelphia", "Tampa Bay sunsets",
  "Jacksonville", "chai at 2am", "anime marathons",
];
const note = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18 V5 L20 3 V16"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="16" r="2.5"/></svg>`;
---
<footer class="foot">
  <svg class="foot__mecha" viewBox="0 0 160 140" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="A doodle of a mecha helmet">
    <g filter="url(#wobble)">
      <!-- V-fin crest -->
      <path d="M80 44 L30 6 L44 30 L72 48" />
      <path d="M80 44 L130 6 L116 30 L88 48" />
      <path d="M74 40 L80 26 L86 40" />
      <!-- helmet -->
      <path d="M50 54 C 50 34, 110 34, 110 54 L 114 86 C 114 98, 104 108, 96 112 L 64 112 C 56 108, 46 98, 46 86 Z" />
      <path d="M56 50 L104 50" />
      <!-- visor -->
      <path d="M56 66 L74 72 L72 78 L56 74 Z" />
      <path d="M104 66 L86 72 L88 78 L104 74 Z" />
      <!-- mouth guard + vents -->
      <path d="M66 86 L94 86 L90 104 L70 104 Z" />
      <path d="M72 92 L88 92 M73 98 L87 98" />
      <!-- cheek vents -->
      <path d="M48 70 L42 72 L42 92 L48 96 M112 70 L118 72 L118 92 L112 96" />
      <path d="M44 78 L48 78 M44 84 L48 84 M116 78 L112 78 M116 84 L112 84" />
      <!-- chin -->
      <path d="M70 112 L74 124 L86 124 L90 112" />
    </g>
  </svg>
  <div class="foot__ticker">
    <span class="foot__note" set:html={note} aria-hidden="true" />
    <div class="foot__mask">
      <div class="foot__track" data-ticker>
        {[0, 1].map((k) => (
          <span class="foot__row" aria-hidden={k === 1 ? "true" : undefined}>
            {ticker.map((t) => <span class="foot__item">{t}</span>)}
          </span>
        ))}
      </div>
    </div>
    <span class="foot__note" set:html={note} aria-hidden="true" />
  </div>
  <p class="foot__sig hand">Rishabh<span>.</span></p>
  <nav class="foot__links" aria-label="Elsewhere">
    {SITE.socials.map((s) => <a href={s.href} target="_blank" rel="noopener me">{s.label}</a>)}
    <a href={`mailto:${SITE.email}`}>Email</a>
  </nav>
  <p class="foot__fine">© 2026 Rishabh Sharma · sketched in Tampa, FL</p>
</footer>
