---
// The loader's ninja hides behind the hero name and peeks over the top of a letter. Its eyes
// follow the cursor; touch its letter (or tap it) and it poofs and pops up behind another one.
---
<span class="peek" aria-hidden="true" data-peek>
  <span class="peek__win">
    <svg class="peek__head" viewBox="0 0 120 88" data-peek-head>
      <g fill="var(--desk)" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M24 52 L10 40 L28 36 L16 18 L38 24 L40 6 L54 20 L64 2 L72 20 L88 6 L88 26 L108 18 L96 38 L112 44 L96 52 Z" />
        <path d="M24 56 C 22 84, 30 100, 60 100 C 90 100, 98 84, 96 56 Z" />
        <path d="M22 50 Q60 40 98 50 L98 60 Q60 50 22 60 Z" />
        <rect x="44" y="44" width="32" height="15" rx="3" />
        <path fill="none" d="M60 52 m-4 0 a4 4 0 1 1 4 4 a6 6 0 1 1 6-6" />
        <path fill="none" d="M98 54 L110 62 L106 50 M98 57 L114 70" />
        <path fill="none" d="M37 66 L51 69 M83 66 L69 69" />
        <g data-peek-eyes>
          <circle cx="46" cy="77" r="6.5" /><circle cx="74" cy="77" r="6.5" />
          <g data-peek-pupils fill="currentColor" stroke="none"><circle cx="46" cy="77" r="2.8" /><circle cx="74" cy="77" r="2.8" /></g>
        </g>
        <path fill="none" d="M29 81 L37 83 M28 86 L37 87 M91 81 L83 83 M92 86 L83 87" />
      </g>
    </svg>
  </span>
  <svg class="peek__hands" viewBox="0 0 120 16" data-peek-hands>
    <g fill="var(--desk)" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round">
      <path d="M14 13 V7 a4 4 0 0 1 8 0 V13 M22 13 V6 a4 4 0 0 1 8 0 V13 M30 13 V7 a4 4 0 0 1 8 0 V13" />
      <path d="M82 13 V7 a4 4 0 0 1 8 0 V13 M90 13 V6 a4 4 0 0 1 8 0 V13 M98 13 V7 a4 4 0 0 1 8 0 V13" />
    </g>
  </svg>
  <span class="loader__puff" data-peek-puff><i /><i /><i /><i /><i /></span>
</span>
