---
// Luffy, drawn in the same line style as the loader's ninja. He grins over the top of the
// contact card; tap him and it's Gomu Gomu no Red Hawk: a haki-black fist on fire
// shoots across the card, bursts into embers and snaps back.
---
<div class="cameo luffy" aria-hidden="true" data-luffy>
  <span class="cameo__win">
    <svg class="cameo__head" viewBox="-6 -4 132 108" data-cameo-head>
      <g fill="var(--desk)" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <!-- messy hair poking out at the sides, ears, face -->
        <path class="luffy__hair" d="M32 44 Q 24 54 17 66 Q 25 62 28 60 Q 24 70 22 80 Q 30 70 34 64 Z M88 44 Q 96 54 103 66 Q 95 62 92 60 Q 96 70 98 80 Q 90 70 86 64 Z" />
        <path d="M31 66 C 25 63, 23 72, 28 76 C 30 78, 32 77, 33 76" />
        <path d="M89 66 C 95 63, 97 72, 92 76 C 90 78, 88 77, 87 76" />
        <path d="M30 50 C 28 80, 40 100, 60 103 C 80 100, 92 80, 90 50 Z" />
        <!-- bangs: a few chunky messy spikes -->
        <path class="luffy__hair" d="M31 46 Q 32 56 33 66 Q 38 58 41 54 Q 44 62 45 69 Q 50 60 53 54 Q 57 60 59 66 Q 62 58 66 53 Q 70 59 74 66 Q 76 58 79 54 Q 83 60 87 64 Q 89 54 89 46 Z" />
        <!-- big eyes (they follow you), or squeezed shut when he laughs -->
        <g data-cameo-eyes class="luffy__open">
          <ellipse cx="47" cy="75" rx="6" ry="7.2" /><ellipse cx="73" cy="75" rx="6" ry="7.2" />
          <g data-cameo-pupils><g fill="currentColor" stroke="none"><ellipse cx="47" cy="76" rx="3.6" ry="4.4" /><ellipse cx="73" cy="76" rx="3.6" ry="4.4" /></g>
            <g fill="var(--desk)" stroke="none"><circle cx="48.3" cy="74.4" r="1.3" /><circle cx="74.3" cy="74.4" r="1.3" /></g></g>
        </g>
        <path class="luffy__shut" fill="none" stroke-width="3.4" d="M40 77 Q 47 68 54 77 M66 77 Q 73 68 80 77" />
        <!-- the stitched scar under his left eye -->
        <path fill="none" stroke-width="1.8" d="M69 87 Q 74 88.5 79 86.5 M71 85.3 l 0.6 3.6 M74.4 85.8 l 0.4 3.6 M77.6 85 l 0.2 3.4" />
        <path fill="none" stroke-width="2" d="M58.5 82 q 1.5 1.2 3 0" />
        <!-- the giant ear-to-ear grin -->
        <path d="M37 85 Q 60 93 83 85 Q 81 101 60 101 Q 39 101 37 85 Z" />
        <path fill="none" stroke-width="1.8" d="M39 89.5 Q 60 97 81 89.5 M43 96.5 Q 60 100 77 96.5 M50 92.6 V 98.6 M60 93.8 V 100 M70 92.6 V 98.6" />
        <!-- the straw hat, tipped a little -->
        <g class="luffy__hat" transform="rotate(-6 60 40)" data-luffy-hat>
          <ellipse class="luffy__straw" cx="60" cy="45" rx="56" ry="9.5" />
          <path fill="none" stroke-width="1.6" d="M8 46 l 7 -1 M12 51 l 7 -2 M24 54.5 l 5 -2.4 M100 50 l -6 -2 M110 45 l -7 0 M106 40 l -6 1 M14 40 l 6 1.5" />
          <path class="luffy__straw" d="M33 44 C 32 22, 44 8, 60 8 C 76 8, 88 22, 87 44 A 27 5 0 0 1 33 44 Z" />
          <path fill="none" stroke-width="1.6" d="M42 18 Q 60 12 78 18 M37 27 Q 60 21 83 27" />
          <path class="luffy__band" d="M33 36 A 27 5 0 0 0 87 36 L 87 44 A 27 5 0 0 1 33 44 Z" />
        </g>
      </g>
    </svg>
  </span>
  <svg class="cameo__hands" viewBox="0 0 120 16" data-cameo-hands>
    <g fill="var(--desk)" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round">
      <path data-hand-l d="M14 13 V7 a4 4 0 0 1 8 0 V13 M22 13 V6 a4 4 0 0 1 8 0 V13 M30 13 V7 a4 4 0 0 1 8 0 V13" />
      <path d="M82 13 V7 a4 4 0 0 1 8 0 V13 M90 13 V6 a4 4 0 0 1 8 0 V13 M98 13 V7 a4 4 0 0 1 8 0 V13" />
    </g>
  </svg>
  <!-- Gomu Gomu no Red Hawk: a haki-black fist wrapped in fire, trailing flames back up the arm -->
  <span class="luffy__pistol" data-luffy-pistol>
    <svg class="luffy__fire" viewBox="0 0 160 90" data-luffy-fire>
      <path class="f1" d="M6 45 C 4 24, 22 8, 38 16 C 44 2, 64 -2, 72 10 C 82 0, 104 4, 108 16 C 124 10, 146 18, 150 28 C 136 30, 128 36, 118 40 C 136 42, 156 52, 154 62 C 138 58, 120 60, 108 64 C 118 72, 112 86, 96 82 C 84 88, 66 86, 56 78 C 40 84, 22 78, 18 70 C 8 66, 6 56, 6 45 Z" />
      <path class="f2" d="M6 45 C 4 24, 22 8, 38 16 C 44 2, 64 -2, 72 10 C 82 0, 104 4, 108 16 C 124 10, 146 18, 150 28 C 136 30, 128 36, 118 40 C 136 42, 156 52, 154 62 C 138 58, 120 60, 108 64 C 118 72, 112 86, 96 82 C 84 88, 66 86, 56 78 C 40 84, 22 78, 18 70 C 8 66, 6 56, 6 45 Z" />
      <path class="f3" d="M6 45 C 4 24, 22 8, 38 16 C 44 2, 64 -2, 72 10 C 82 0, 104 4, 108 16 C 124 10, 146 18, 150 28 C 136 30, 128 36, 118 40 C 136 42, 156 52, 154 62 C 138 58, 120 60, 108 64 C 118 72, 112 86, 96 82 C 84 88, 66 86, 56 78 C 40 84, 22 78, 18 70 C 8 66, 6 56, 6 45 Z" />
    </svg>
    <svg class="luffy__fist" viewBox="0 0 40 34"><path d="M30 6 Q14 2 8 8 Q2 12 4 20 Q6 30 18 30 L30 28 Z M8 12 Q16 12 18 16 M6 19 Q14 19 17 22 M8 25 Q14 25 17 27" /></svg>
    <span class="luffy__embers" data-luffy-embers>{Array.from({ length: 12 }, () => <i />)}</span>
  </span>
  <span class="loader__puff" data-cameo-puff><i /><i /><i /><i /><i /><i /></span>
  <span class="bubble cameo__say" data-cameo-say>join my crew!</span>
</div>
