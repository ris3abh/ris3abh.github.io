---
// First-visit loader: my face sketches itself, a counter runs, then the face flies into the nav.
---
<div class="loader" data-loader aria-hidden="true">
  <div class="loader__inner">
    <svg class="loader__face" viewBox="0 0 100 100" data-loader-face>
      <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" filter="url(#wobble)">
        <path d="M24 46 C 16 30, 26 14, 40 18 C 44 8, 60 8, 64 16 C 74 10, 88 20, 80 34 C 86 40, 82 50, 76 48" />
        <path d="M30 30 q 5 -7 10 -2 M48 24 q 6 -6 10 0 M62 30 q 6 -4 8 2" />
        <path d="M27 46 C 25 68, 37 86, 50 86 C 63 86, 75 70, 75 48" />
        <path d="M42 66 Q 50 74 58 66" />
        <path d="M36 76 l1 1 M43 80 l1 1 M57 80 l1 1 M64 76 l1 1" />
        <path d="M37 55 q 3 -3 6 0 M57 55 q 3 -3 6 0" />
      </g>
    </svg>
    <p class="loader__txt"><span data-loader-word>sketching the board</span> <b data-loader-n>0</b></p>
  </div>
</div>
