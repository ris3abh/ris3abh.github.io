---
import "../styles/global.css";
import HangNav from "../components/HangNav.astro";
import Loader from "../components/Loader.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  schema?: Record<string, unknown>[];
  ogType?: string;
  nav?: "about" | "work" | "connect" | "journey";
  noindex?: boolean;
  image?: string;
}
const { title = SITE.title, description = SITE.description, path = "/", schema = [], ogType = "profile", nav, noindex = false, image } = Astro.props;

const canonical = `${SITE.url}${path}`;
const FONTS = "https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Silkscreen&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap";
const og = `${SITE.url}${image ?? "/og.png"}`;
const headshot = `${SITE.url}/img/rishabh.webp`;
const personId = `${SITE.url}/#person`;
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: SITE.name,
      url: SITE.url,
      image: { "@type": "ImageObject", url: headshot, width: 320, height: 320 },
      jobTitle: "AI Research Engineer",
      hasOccupation: [
        { "@type": "Occupation", name: "AI Research Engineer", occupationLocation: { "@type": "City", name: "Tampa, FL" } },
        { "@type": "Occupation", name: "Paper reviewer" },
        { "@type": "Occupation", name: "Hackathon judge and mentor" },
      ],
      description: SITE.description,
      email: `mailto:${SITE.email}`,
      address: { "@type": "PostalAddress", addressLocality: "Tampa", addressRegion: "FL", addressCountry: "US" },
      worksFor: { "@type": "Organization", name: "Spinutech", url: "https://www.spinutech.com" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Drexel University", sameAs: "https://drexel.edu" },
      hasCredential: { "@type": "EducationalOccupationalCredential", name: "AWS Certified Data Engineer – Associate" },
      knowsAbout: ["AI agents", "Peer review", "Agent memory", "Autonomous research systems", "LLM evaluation", "Pre-registered experiments", "Model Context Protocol", "Machine learning", "Data engineering"],
      sameAs: SITE.socials.map((s) => s.href).filter((h) => !h.includes("arxiv")),
      subjectOf: { "@type": "ScholarlyArticle", name: "When Does Selection Replace Extraction? A Pre-Registered Test of Agent Memory with a Typed Decision Model", url: "https://arxiv.org/abs/2609.34227" },
    },
    { "@type": "SoftwareSourceCode", "@id": "https://www.archimedes.run/#project", name: "archimedes.run", url: "https://www.archimedes.run", codeRepository: "https://github.com/archimedes-run/ai-research-engineer", author: { "@id": personId } },
    { "@type": "WebSite", "@id": `${SITE.url}/#website`, url: SITE.url, name: SITE.name, publisher: { "@id": personId } },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#141516" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={FONTS} />
    <link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS} /></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <script is:inline>document.documentElement.classList.add("js");try{if(sessionStorage.getItem("rs-loaded")||navigator.webdriver||/bot|crawl|spider|lighthouse|headless/i.test(navigator.userAgent)||matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("loaded")}catch(e){}</script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>

    <!-- shared hand-drawn wobble -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="wobble"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" /><feDisplacementMap in="SourceGraphic" scale="2.4" /></filter>
    </svg>

    <Loader />
    <HangNav active={nav} />

    <main id="main"><slot /></main>
    <Footer />

    <script>
      import { boot } from "../scripts/motion";
      boot();
    </script>
  </body>
</html>
